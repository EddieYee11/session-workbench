<?xml version="1.0" encoding="utf-8"?>
<!-- Android's adaptive foreground uses a 108 dp canvas; 14 dp insets keep
     the joined faces and beret inside the central mask-safe area. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="14dp"
    android:insetTop="14dp"
    android:insetRight="14dp"
    android:insetBottom="14dp">
    <bitmap android:src="@drawable/ic_launcher_art" android:gravity="fill" android:filter="true" />
</inset>
